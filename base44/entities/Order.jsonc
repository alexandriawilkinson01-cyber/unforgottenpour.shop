{
  "name": "Order",
  "type": "object",
  "properties": {
    "customer_name": {
      "type": "string",
      "title": "Customer Name"
    },
    "customer_email": {
      "type": "string",
      "title": "Customer Email",
      "format": "email"
    },
    "phone": {
      "type": "string",
      "title": "Phone"
    },
    "amount": {
      "type": "number",
      "title": "Amount"
    },
    "currency": {
      "type": "string",
      "title": "Currency",
      "default": "USD"
    },
    "product": {
      "type": "string",
      "title": "Product"
    },
    "category": {
      "type": "string",
      "title": "Category"
    },
    "format": {
      "type": "string",
      "title": "Preferred Format"
    },
    "description": {
      "type": "string",
      "title": "Item Description",
      "maxLength": 1000
    },
    "instructions": {
      "type": "string",
      "title": "Special Instructions",
      "maxLength": 1000
    },
    "stripe_session_id": {
      "type": "string",
      "title": "Stripe Session ID"
    },
    "stripe_payment_intent_id": {
      "type": "string",
      "title": "Stripe Payment Intent ID"
    },
    "square_order_id": {
      "type": "string",
      "title": "Square Order ID"
    },
    "status": {
      "type": "string",
      "title": "Status",
      "enum": [
        "new",
        "processing",
        "in_production",
        "shipped",
        "delivered"
      ],
      "default": "new"
    }
  },
  "required": [
    "customer_name",
    "amount",
    "product"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}